# Safe, non-secret development defaults for commands run directly on the host.
# Docker Compose overrides the two service URLs with its internal DNS names.
EVALGUARD_DATABASE_URL=postgresql+psycopg://evalguard:evalguard@localhost:5432/evalguard
EVALGUARD_REDIS_URL=redis://localhost:6379/0
EVALGUARD_ENVIRONMENT=development
EVALGUARD_LOG_LEVEL=INFO
EVALGUARD_QUEUE_NAME=evalguard

# Bounded Phase 6 provider defaults. The real-provider path is opt-in and these
# non-secret values are server-owned experiment identity, not client parameters.
EVALGUARD_REAL_PROVIDER_ENABLED=false
EVALGUARD_OPENAI_MODEL=gpt-5.6-luna
EVALGUARD_OPENAI_REASONING_EFFORT=none
EVALGUARD_OPENAI_MAX_OUTPUT_TOKENS=1200
EVALGUARD_OPENAI_MAX_TURNS=6
EVALGUARD_OPENAI_REQUEST_TIMEOUT_SECONDS=45
EVALGUARD_OPENAI_MAX_EXPERIMENT_COST_USD=5.00

# Worker-only secret name. Leave commented and empty in this example. Docker
# Compose deliberately does not forward it through the shared API environment.
# EVALGUARD_OPENAI_API_KEY=

# pytest uses isolated targets and refuses to clean development data.
EVALGUARD_TEST_DATABASE_URL=postgresql+psycopg://evalguard:evalguard@localhost:5432/evalguard_test
EVALGUARD_TEST_REDIS_URL=redis://localhost:6379/15
EVALGUARD_TEST_QUEUE_NAME=evalguard-tests

# Docker Compose development settings. These values are intentionally local-only.
POSTGRES_DB=evalguard
POSTGRES_USER=evalguard
POSTGRES_PASSWORD=evalguard
POSTGRES_PORT=5432
REDIS_PORT=6379
EVALGUARD_API_PORT=8000
